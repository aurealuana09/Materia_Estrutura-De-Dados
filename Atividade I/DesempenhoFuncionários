#include <stdio.h>

int main() {
    int funcionarioA[] = {8, 7, 9};   // produtividade, qualidade, pontualidade
    int funcionarioB[] = {6, 7, 10};

    int pontosA = 0;
    int pontosB = 0;

    for (int i = 0; i < 3; i++) {
        if (funcionarioA[i] > funcionarioB[i]) {
            pontosA++;
        } else if (funcionarioB[i] > funcionarioA[i]) {
            pontosB++;
        }
    }

    printf("Pontos do Funcionário A: %d\n", pontosA);
    printf("Pontos do Funcionário B: %d\n", pontosB);

    return 0;
}
