#include <stdio.h>

int main() {
    int reproducoes[] = {120, 150, 80, 200, 300, 250};
    int dias = 6;

    int maior_soma = 0;
    int indice1 = 0;
    int indice2 = 1;

    for (int i = 0; i < dias - 1; i++) {
        int soma = reproducoes[i] + reproducoes[i + 1];

        if (soma > maior_soma) {
            maior_soma = soma;
            indice1 = i;
            indice2 = i + 1;
        }
    }

    printf("Maior soma de reproduções consecutivas: %d\n", maior_soma);
    printf("Dias encontrados nos índices: %d e %d\n", indice1, indice2);

    return 0;
}

