#include <stdio.h>

int main() {
    int numeros[] = {0, 2, 4, 6, 8, 12, 14, 16, 18};
    int tamanho = 9;

    printf("Números maiores que 5 da sua lista:\n");

    for (int i = 0; i < tamanho; i++) {
        if (numeros[i] > 5) {
            printf("%d ", numeros[i]);
        }
    }

    return 0;
}
