#include <stdio.h>

int main() {
    char s[] = "ola, mundo";
    int vogais = 0;
    int consoantes = 0;

    for (int i = 0; s[i] != '\0'; i++) {

        // Verifica se é letra minúscula
        if (s[i] >= 'a' && s[i] <= 'z') {

            // Verifica se é vogal
            if (s[i] == 'a' || s[i] == 'e' || s[i] == 'i' ||
                s[i] == 'o' || s[i] == 'u') {
                vogais++;
            } else {
                consoantes++;
            }
        }
    }

    printf("Vogais : %d \nConsoantes: %d\n", vogais, consoantes);

    return 0;
}
